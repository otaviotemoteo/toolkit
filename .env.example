# Copy to .env and fill in what you need. Nothing here is read automatically:
# either export it, or source the file. Kept out of git; .env.local is too.
#
# The default backend is fake, so a missing key produces a placeholder and a
# clear message rather than a surprise charge.

# Which backend generate.py uses.
#   fake      placeholder, no key, no cost, exercises the whole path
#   local     mflux on Apple Silicon, no account, no quota, no cost
#   local-cn  local plus ControlNet. Discards the negative prompt: see
#             docs/solutions/the-negative-block-was-carrying-the-style.md
#   openai    hosted, needs prepaid API credit
#   gemini    hosted, image generation is not on the free tier
IMAGE_BACKEND=fake

# --- local generation, the default real backend -----------------------------
# Downloaded already quantised, so no 16 bit checkpoint is ever fetched.
MFLUX_MODEL=mflux-community/z-image-base-mflux-q4
MFLUX_CN_MODEL=mflux-community/z-image-turbo-controlnet-union-2-1-mflux-q4
MFLUX_STEPS=24
MFLUX_CN_STEPS=14
# Must stay above 1.0. At or below it guidance is off, there is no second pass,
# and the entire negative block is discarded in silence.
MFLUX_GUIDANCE=3.5
# Fix to reproduce a result exactly. Leave unset to sample.
MFLUX_SEED=
# Caps the MLX cache. 6 keeps a 16 GB machine off swap during the VAE decode.
MFLUX_CACHE_GB=6

# --- hosted, optional -------------------------------------------------------
# platform.openai.com. Prepaid API credit, which no ChatGPT subscription
# includes: see docs/solutions/subscription-is-not-api-credit.md
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# aistudio.google.com. Issues a key with no card, and the free tier covers text
# but not images: every image model reports a limit of zero.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# The API rejects image/png on this endpoint and accepts only image/jpeg,
# contradicting its own documentation. Overridable for the day that changes.
GEMINI_IMAGE_MIME=image/jpeg

# zenmux.ai. Never executed: the endpoint and response shape are assumed from
# OpenAI compatibility and have never been proven against the real service.
ZENMUX_API_KEY=
ZENMUX_IMAGE_MODEL=google/gemini-2.5-flash-image
