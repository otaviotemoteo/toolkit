.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.DS_Store

# Generated images are build output, not source, and so are the JSON sidecars
# written beside them. A run that gets approved is copied, image and sidecar,
# into briefs/<name>/approved/, which is tracked.
briefs/*/out/
out/

# ---------------------------------------------------------------------------
# What is untracked on purpose. docs/workspace.md is the map of all of it.
#
# The rule: every document is tracked. What is not tracked is output, which is
# images and the files a script rebuilds, and session state.
# ---------------------------------------------------------------------------

# Session state. Read at the start of a session, written before the end.
PROGRESS.md

# The raw output of the layer cut. Regenerable in a second from the approved
# cutout, and assembled into approved/*/scene/, which is what is tracked.
briefs/*/approved/layers/

# The approved images of the portfolio this toolkit was built for. Their briefs
# are tracked, as worked examples of the format. One asset keeps its images as
# well, briefs/hero-character/, and docs/examples/ walks through it. Named one
# by one on purpose: a blanket briefs/*/approved/ would hide the assets you are
# about to approve.
briefs/card-devtrack/approved/
briefs/card-personal-tracker/approved/
briefs/card-phishing/approved/
briefs/card-sales/approved/
briefs/card-service-order/approved/
briefs/card-smart-home/approved/
briefs/character-profile/approved/
briefs/contact-desk/approved/
briefs/contact-greeting/approved/
briefs/strip-fire/approved/
briefs/strip-scene/approved/
# A harness page that only composes with the images above.
preview/strip.html

# The frames each round of iteration produced. The notes beside them are
# tracked; the pictures are not.
docs/history/**/*.png
